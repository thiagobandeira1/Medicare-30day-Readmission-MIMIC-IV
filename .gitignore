# ── Data (PhysioNet licensing — never commit) ─────────────────────────────
data/
!data/.gitkeep
*.parquet
*.csv.gz
*.feather

# ── Large run artefacts (regenerated by src/run_v7_ensemble.py + run_5fold_cv.py)
results/*.npz
results/*.pkl
results/_patient_split.json
results/cv5_*_folds.json

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Jupyter ────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.nbconvert.ipynb
*_smoke.ipynb
*.ipynb.bak

# ── Editor / OS ────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# ── Secrets / credentials ──────────────────────────────────────────────────
.env
.env.*
*.pem
*.key
credentials.json
google-credentials.json
service-account.json
*.token

# ── Logs ───────────────────────────────────────────────────────────────────
*.log
logs/

# ── Build / distribution ───────────────────────────────────────────────────
build/
dist/
*.tar.gz
*.zip

